# Copy to server/.env for local development.
# Local dev database from docker-compose.yml:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/salary"

# Test database (used by npm test and scripts/smoke.mjs):
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/salary_test"

# Demo HR account created by the seed; set your own for any real deployment:
# HR_EMAIL="hr@acme.example"
# HR_PASSWORD="change-me"

# Required in production; the API refuses to boot without it there:
# JWT_SECRET="generate-a-long-random-string"
